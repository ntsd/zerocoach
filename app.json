{
  "expo": {
    "name": "ZeroCoach",
    "slug": "zerocoach",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0E14",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zerocoach.app",
      "infoPlist": {
        "NSHealthShareUsageDescription": "ZeroCoach reads your steps, heart rate, sleep duration, and active energy burn to calculate athletic recovery readiness and optimize training volume.",
        "NSHealthUpdateUsageDescription": "ZeroCoach saves athletic recovery metrics and telemetry to Apple Health."
      }
    },
    "android": {
      "package": "com.zerocoach.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B0E14",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_TOTAL_CALORIES_BURNED",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_RESTING_HEART_RATE",
        "android.permission.health.READ_HEART_RATE_VARIABILITY",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_HEIGHT",
        "android.permission.CAMERA"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "llama.rn",
      [
        "react-native-health-connect",
        {
          "packageNames": [
            "com.google.android.apps.healthdata"
          ]
        }
      ],
      [
        "react-native-health",
        {
          "healthSharePermission": "ZeroCoach reads your steps, heart rate, sleep duration, and active energy burn to calculate athletic recovery readiness and optimize training volume.",
          "healthUpdatePermission": "ZeroCoach saves athletic recovery metrics and telemetry to Apple Health."
        }
      ]
    ],
    "experiments": {
      "tsconfigPaths": true
    },
    "extra": {
      "eas": {
        "projectId": "5ce2eec9-4f3d-4b0c-ac28-afed84d5d5b6"
      }
    },
    "owner": "ntsd"
  }
}
