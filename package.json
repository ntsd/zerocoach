{
  "name": "zerocoach",
  "version": "1.2.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.29",
    "expo-build-properties": "~57.0.22",
    "expo-camera": "~57.0.6",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.26",
    "llama.rn": "^0.13.0-rc.7",
    "lucide-react-native": "^1.57.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-health": "^1.19.0",
    "react-native-health-connect": "^4.1.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eas-cli": "^25.1.1",
    "patch-package": "^8.0.1",
    "typescript": "~5.9.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:apk": "cd android && ./gradlew assembleRelease",
    "build:apk-debug": "cd android && ./gradlew assembleDebug",
    "build:aab": "cd android && ./gradlew bundleRelease",
    "publish:android": "npm run build:aab && npx eas submit --platform android --path android/app/build/outputs/bundle/release/app-release.aab",
    "publish:ios": "npx eas build --platform ios --profile production --local --auto-submit",
    "build:ios": "eas build --platform ios --profile production --auto-submit",
    "build:android": "eas build --platform android --profile production --auto-submit",
    "update:publish": "eas update --branch production",
    "update:preview": "eas update --branch preview",
    "postinstall": "patch-package"
  },
  "private": true
}
