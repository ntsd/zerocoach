---
import { Smartphone, Brain, Cpu, Dumbbell, Eye, ShieldCheck, Zap, Minimize2, Clock } from 'lucide-astro';

const stackLayers = [
  {
    layer: "01. Application & Mobile UX",
    tech: "React Native + Expo",
    description: "Built with TypeScript for smooth 60fps performance on iOS and Android. Obsidian theme tokens, glassmorphism, and responsive safe insets.",
    tag: "Mobile Framework",
    icon: Smartphone
  },
  {
    layer: "02. AI Agent & Dynamic Intent Scoping",
    tech: "Intent Router + Tool Harness",
    description: "Sub-millisecond bilingual intent classifier (EN/TH) scoping tool declarations down to ~75–140 tokens while keeping ambient athlete memory permanently active.",
    tag: "Context Optimization",
    icon: Brain
  },
  {
    layer: "03. Neural Inference Engine",
    tech: "llama.rn & Session-Scoped Vision",
    description: "Native C++ execution with ARM64 NEON & Apple Metal. 4,096-token KV capacity with on-demand vision projector lifecycle saving 600 MB heap during text coaching.",
    tag: "On-Device AI",
    icon: Cpu
  },
  {
    layer: "04. Exercise Intelligence",
    tech: "RepDB Verified Repository",
    description: "643 science-backed movements with start and peak pose kinematics, dynamic warmup builders, and CNS readiness load auto-regulation.",
    tag: "Biomechanics",
    icon: Dumbbell
  },
  {
    layer: "05. Multimodal Nutrition",
    tech: "Gemini Vision & NutriSight",
    description: "Plate meal decomposition via Gemini 3.8 Flash, Open Food Facts barcode lookup, and NutriSight label extraction for 11 micronutrients.",
    tag: "Computer Vision",
    icon: Eye
  },
  {
    layer: "06. Biometric Bridge & Persistence",
    tech: "Health Connect + Zustand",
    description: "OS health aggregators reading resting HR, HRV, and sleep. All logs stay encrypted in local AsyncStorage with 1-tap instant data wipe.",
    tag: "Privacy & Storage",
    icon: ShieldCheck
  }
];

const parityDomains = [
  { domain: "Fitness Telemetry", ui: "View Readiness (0–100), HRV, resting HR, sleep, steps, and sync wearables", agent: "Read biometrics via get_telemetry_metrics(), trigger sync with sync_fitness_telemetry()", access: "Read / Action" },
  { domain: "Food History", ui: "Browse meal logs by date, log meals, delete items, update macro targets", agent: "Read food history, log food items, delete entries, and update macro targets", access: "Read / Write" },
  { domain: "Food Database", ui: "Search whole foods (USDA), query packaged goods (Open Food Facts), scan barcodes", agent: "Search USDA & Open Food Facts databases and fetch nutrient profiles by barcode", access: "Read" },
  { domain: "Workout History", ui: "Review past workout sessions, volume, and sets by calendar date", agent: "Read workout history across recent days and log finished workout sessions", access: "Read / Write" },
  { domain: "Workout Plan", ui: "View adaptive daily splits, swap/skip exercises, schedule future routines", agent: "Read daily workout plans, update full routines, and swap exercises from RepDB", access: "Read / Write" },
  { domain: "Workout DB (RepDB)", ui: "Browse 643 movements, filter by muscle/equipment, view poses & cues", agent: "Search 643 movements and retrieve kinetic cues, biomechanics, and pose metadata", access: "Read" },
  { domain: "ZeroCoach Settings", ui: "Update athlete profile, goals, weight/height, switch coach persona, language", agent: "Read athlete profile settings and update goals, body weight, coach tone, or language", access: "Read / Write" },
  { domain: "Athlete Memory", ui: "View, filter, add, or delete categorized memories (food, skills, injuries, personality)", agent: "Reconcile facts (ADD/UPDATE/DELETE) via save_memory(), get_memories(), remove_memory()", access: "Read / Write" }
];
---

<section id="architecture" class="py-20 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-semibold bg-cyan-500/10 text-cyan-400 border border-cyan-500/30 mb-4">
        <span>ENGINEERING DEEP DIVE</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-black tracking-tight text-white">
        System Specifications & Open Engineering Architecture.
      </h2>
      <p class="mt-4 text-base sm:text-lg text-slate-400">
        A resilient, fully open-source architecture designed with 100% symmetric parity between the Mobile UI and AI Agent Action Harness.
      </p>
    </div>

    <!-- Tech Stack Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-20">
      {stackLayers.map((layer) => {
        const IconComponent = layer.icon;
        return (
          <div class="glass-panel p-6 rounded-3xl border border-white/5 glass-panel-hover flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-4">
                <div class="w-10 h-10 rounded-xl bg-cyan-500/10 border border-cyan-500/30 flex items-center justify-center">
                  <IconComponent class="w-5 h-5 text-cyan-400" />
                </div>
                <span class="text-[10px] font-mono font-medium px-2 py-0.5 rounded-full bg-white/5 text-slate-300 border border-white/10">{layer.tag}</span>
              </div>
              <span class="text-xs font-mono text-cyan-400 font-bold uppercase tracking-wider block mb-1">{layer.layer}</span>
              <h3 class="text-xl font-bold text-white mb-2">{layer.tech}</h3>
              <p class="text-sm text-slate-400 leading-relaxed">{layer.description}</p>
            </div>
          </div>
        );
      })}
    </div>

    <!-- Symmetric Read/Write Parity Matrix -->
    <div class="glass-panel p-6 sm:p-10 rounded-3xl border border-white/5">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
        <div>
          <span class="text-xs font-mono text-cyan-400 font-bold uppercase tracking-wider">SYMMETRIC ACCESS MODEL</span>
          <h3 class="text-2xl font-bold text-white mt-1">App UI & AI Agent Parity Matrix</h3>
        </div>
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-xs font-mono text-cyan-300 self-start sm:self-auto">
          <span>8 Core Domains</span>
        </div>
      </div>

      <!-- Desktop Table -->
      <div class="hidden sm:block overflow-x-auto">
        <table class="w-full text-left text-sm border-collapse">
          <thead>
            <tr class="border-b border-white/10 text-xs font-mono uppercase tracking-wider text-slate-400">
              <th class="py-3 px-4">Domain</th>
              <th class="py-3 px-4">Access</th>
              <th class="py-3 px-4">App UI Access</th>
              <th class="py-3 px-4">AI Agent Harness Access</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/5">
            {parityDomains.map((row) => (
              <tr class="hover:bg-white/[0.02] transition-colors">
                <td class="py-4 px-4 font-mono font-bold text-white whitespace-nowrap">{row.domain}</td>
                <td class="py-4 px-4 font-mono text-xs whitespace-nowrap">
                  <span class={`px-2 py-0.5 rounded-full border ${row.access === 'Read / Write' ? 'bg-cyan-500/10 text-cyan-300 border-cyan-500/30' : 'bg-slate-800 text-slate-300 border-white/10'}`}>
                    {row.access}
                  </span>
                </td>
                <td class="py-4 px-4 text-slate-300 text-xs sm:text-sm">{row.ui}</td>
                <td class="py-4 px-4 text-cyan-200/90 text-xs sm:text-sm font-mono">{row.agent}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- Mobile Stacked Domain Cards -->
      <div class="sm:hidden space-y-3">
        {parityDomains.map((row) => (
          <div class="p-4 rounded-2xl bg-slate-900/80 border border-white/5 space-y-2 text-xs">
            <div class="flex items-center justify-between">
              <span class="font-mono font-bold text-white text-sm">{row.domain}</span>
              <span class={`px-2 py-0.5 rounded-full border font-mono text-[10px] ${row.access === 'Read / Write' ? 'bg-cyan-500/10 text-cyan-300 border-cyan-500/30' : 'bg-slate-800 text-slate-300 border-white/10'}`}>
                {row.access}
              </span>
            </div>
            <div class="text-slate-300"><span class="text-slate-400 font-mono">UI:</span> {row.ui}</div>
            <div class="text-cyan-200 font-mono text-[11px]"><span class="text-slate-400">Agent:</span> {row.agent}</div>
          </div>
        ))}
      </div>
    </div>

    <!-- On-Device Context & Memory Efficiency Metrics -->
    <div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4">
      <div class="glass-panel p-5 rounded-2xl border border-white/5 text-center flex flex-col items-center justify-center">
        <Zap class="w-6 h-6 text-cyan-400 mb-2" />
        <span class="text-2xl sm:text-3xl font-black font-mono text-cyan-400 block">-600 MB</span>
        <span class="text-xs text-slate-400 mt-1 block">RAM Saved (Lazy Vision)</span>
      </div>
      <div class="glass-panel p-5 rounded-2xl border border-white/5 text-center flex flex-col items-center justify-center">
        <Minimize2 class="w-6 h-6 text-emerald-400 mb-2" />
        <span class="text-2xl sm:text-3xl font-black font-mono text-emerald-400 block">&lt;90 Tok</span>
        <span class="text-xs text-slate-400 mt-1 block">Scoped Tool Declaration</span>
      </div>
      <div class="glass-panel p-5 rounded-2xl border border-white/5 text-center flex flex-col items-center justify-center">
        <Cpu class="w-6 h-6 text-cyan-400 mb-2" />
        <span class="text-2xl sm:text-3xl font-black font-mono text-cyan-400 block">4,096</span>
        <span class="text-xs text-slate-400 mt-1 block">Full Context Capacity</span>
      </div>
      <div class="glass-panel p-5 rounded-2xl border border-white/5 text-center flex flex-col items-center justify-center">
        <Clock class="w-6 h-6 text-emerald-400 mb-2" />
        <span class="text-2xl sm:text-3xl font-black font-mono text-emerald-400 block">&lt;1 ms</span>
        <span class="text-xs text-slate-400 mt-1 block">Bilingual Intent Router</span>
      </div>
    </div>
  </div>
</section>
