---
---

<section id="features" class="py-24 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-semibold bg-cyan-500/10 text-cyan-400 border border-cyan-500/30 mb-4">
        <span>CORE SYSTEM CAPABILITIES</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-black tracking-tight text-white">
        Architected for Athletes Who Value Privacy.
      </h2>
      <p class="mt-4 text-base sm:text-lg text-slate-400">
        Every algorithm, model inference, and biometric calculation happens on your hardware. Zero cloud dependencies, zero data brokerage.
      </p>
    </div>

    <!-- Bento Grid Container -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- Card 1: 100% On-Device AI Engine (Spans 2 columns on lg) -->
      <div class="lg:col-span-2 glass-panel p-8 rounded-3xl relative overflow-hidden group glass-panel-hover border border-white/5 hover:border-cyan-500/40">
        <div class="absolute -top-12 -right-12 w-64 h-64 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none group-hover:bg-cyan-500/20 transition-all"></div>
        
        <div class="flex items-center gap-3 mb-6">
          <div class="w-12 h-12 rounded-2xl bg-cyan-500/10 border border-cyan-500/30 flex items-center justify-center text-2xl">
            🧠
          </div>
          <div>
            <span class="text-xs font-mono font-bold tracking-widest text-cyan-400 uppercase">Local Neural Engine</span>
            <h3 class="text-2xl font-black text-white">100% On-Device Gemma 2 Coach</h3>
          </div>
        </div>

        <p class="text-slate-300 leading-relaxed mb-6">
          ZeroCoach executes quantized <span class="text-cyan-300 font-semibold">Gemma 2</span> models directly on your smartphone via <span class="text-white font-mono">llama.rn</span> and native <span class="text-white font-mono">llama.cpp</span>. A unified, direct sports-science coaching persona auto-regulates guidance based on live recovery metrics and remaining nutrition budgets.
        </p>

        <!-- Feature chips -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-4 border-t border-white/5 font-mono text-xs">
          <div class="p-3 rounded-xl bg-slate-900/80 border border-white/5">
            <span class="text-cyan-400 block font-bold">0ms Cloud Latency</span>
            <span class="text-slate-400 text-[11px]">Instant local generation</span>
          </div>
          <div class="p-3 rounded-xl bg-slate-900/80 border border-white/5">
            <span class="text-cyan-400 block font-bold">100% Offline Mode</span>
            <span class="text-slate-400 text-[11px]">Works on flights & outdoors</span>
          </div>
          <div class="p-3 rounded-xl bg-slate-900/80 border border-white/5">
            <span class="text-cyan-400 block font-bold">Sports Science</span>
            <span class="text-slate-400 text-[11px]">Direct & data-driven</span>
          </div>
        </div>
      </div>

      <!-- Card 2: Smart Nutrition & Gemini AI Vision -->
      <div class="glass-panel p-8 rounded-3xl relative overflow-hidden group glass-panel-hover border border-white/5 hover:border-cyan-500/40">
        <div class="absolute -top-12 -right-12 w-48 h-48 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none group-hover:bg-emerald-500/20 transition-all"></div>
        
        <div class="flex items-center gap-3 mb-6">
          <div class="w-12 h-12 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-2xl">
            🥗
          </div>
          <div>
            <span class="text-xs font-mono font-bold tracking-widest text-emerald-400 uppercase">Dual-Mode Vision</span>
            <h3 class="text-2xl font-black text-white">Smart Nutrition & NutriSight</h3>
          </div>
        </div>

        <p class="text-slate-300 leading-relaxed mb-6 text-sm">
          Snap a food plate for multimodal decomposition using <span class="text-emerald-300 font-semibold">Gemini 3.8 Flash</span>, or point your camera at nutrition fact labels with <span class="text-emerald-300 font-semibold">Open Food Facts NutriSight</span> token extractors. Includes USDA whole foods and 11 micronutrient RDA bio-gauges.
        </p>

        <div class="p-3 rounded-xl bg-slate-900/80 border border-white/5 font-mono text-xs">
          <div class="flex justify-between items-center text-slate-300 mb-1">
            <span>Micronutrient Bio-Profile</span>
            <span class="text-emerald-400 font-bold">11 RDAs</span>
          </div>
          <div class="text-[11px] text-slate-400">Vitamins A, C, D, B12 • Iron, Calcium, Zinc, Magnesium</div>
        </div>
      </div>

      <!-- Card 3: Adaptive Workout Engine & RepDB -->
      <div class="glass-panel p-8 rounded-3xl relative overflow-hidden group glass-panel-hover border border-white/5 hover:border-cyan-500/40">
        <div class="absolute -top-12 -right-12 w-48 h-48 bg-blue-500/10 rounded-full blur-3xl pointer-events-none group-hover:bg-blue-500/20 transition-all"></div>
        
        <div class="flex items-center gap-3 mb-6">
          <div class="w-12 h-12 rounded-2xl bg-blue-500/10 border border-blue-500/30 flex items-center justify-center text-2xl">
            🏋️
          </div>
          <div>
            <span class="text-xs font-mono font-bold tracking-widest text-blue-400 uppercase">Science-Backed Catalog</span>
            <h3 class="text-2xl font-black text-white">RepDB Workout Engine</h3>
          </div>
        </div>

        <p class="text-slate-300 leading-relaxed mb-6 text-sm">
          Access 643 exercises from the verified RepDB repository with kinetic start and peak pose imagery. Dynamically adjust volume to your readiness, skip or swap movements on the fly, and review past or future training splits with dedicated calendar date navigation.
        </p>

        <div class="p-3 rounded-xl bg-slate-900/80 border border-white/5 font-mono text-xs">
          <div class="flex justify-between items-center text-slate-300 mb-1">
            <span>Date Navigation Parity</span>
            <span class="text-blue-400 font-bold">Active</span>
          </div>
          <div class="text-[11px] text-slate-400">Browse, edit, and log workouts across any historical date</div>
        </div>
      </div>

      <!-- Card 4: Unified Multi-Domain Bio-History (Spans 2 columns on lg) -->
      <div class="lg:col-span-2 glass-panel p-8 rounded-3xl relative overflow-hidden group glass-panel-hover border border-white/5 hover:border-cyan-500/40">
        <div class="absolute -top-12 -right-12 w-64 h-64 bg-indigo-500/10 rounded-full blur-3xl pointer-events-none group-hover:bg-indigo-500/20 transition-all"></div>
        
        <div class="flex items-center gap-3 mb-6">
          <div class="w-12 h-12 rounded-2xl bg-indigo-500/10 border border-indigo-500/30 flex items-center justify-center text-2xl">
            📈
          </div>
          <div>
            <span class="text-xs font-mono font-bold tracking-widest text-indigo-400 uppercase">Wearable Telemetry Bridge</span>
            <h3 class="text-2xl font-black text-white">Unified Athletic Performance Analytics</h3>
          </div>
        </div>

        <p class="text-slate-300 leading-relaxed mb-6">
          Connect directly on-device with <span class="text-indigo-300 font-semibold">Android Health Connect</span> and <span class="text-indigo-300 font-semibold">Apple HealthKit</span> to unify HRV, resting heart rate, sleep architecture, and burn across Garmin, Apple Watch, Whoop, Oura, Samsung, and Pixel wearables. Generates a daily 0–100 composite score with 7D, 14D, and 30D trendlines.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-4 border-t border-white/5 font-mono text-xs">
          <div class="p-3 rounded-xl bg-slate-900/80 border border-white/5">
            <span class="text-indigo-400 block font-bold">Composite 0-100</span>
            <span class="text-slate-400 text-[11px]">CNS (35%) + Lift (35%) + Food (30%)</span>
          </div>
          <div class="p-3 rounded-xl bg-slate-900/80 border border-white/5">
            <span class="text-indigo-400 block font-bold">Zero Cloud Relay</span>
            <span class="text-slate-400 text-[11px]">Direct OS-level health bridge</span>
          </div>
          <div class="p-3 rounded-xl bg-slate-900/80 border border-white/5">
            <span class="text-indigo-400 block font-bold">Smart Scale Recalibration</span>
            <span class="text-slate-400 text-[11px]">Auto-updates daily macro target</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
