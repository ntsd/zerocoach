---
import { Terminal, RefreshCw, Download, ExternalLink } from 'lucide-astro';
---

<section id="download" class="py-24 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="glass-panel p-8 sm:p-14 rounded-3xl border border-cyan-500/30 cyan-glow relative overflow-hidden">
      <!-- Glow effect -->
      <div class="absolute -top-32 -left-32 w-80 h-80 bg-cyan-500/15 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-32 -right-32 w-80 h-80 bg-blue-500/15 rounded-full blur-3xl pointer-events-none"></div>

      <div class="text-center max-w-3xl mx-auto mb-10">
        <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-semibold bg-cyan-500/15 text-cyan-400 border border-cyan-500/30 mb-4">
          <span>GET STARTED IN SECONDS</span>
        </span>
        <h2 class="text-3xl sm:text-5xl font-black tracking-tight text-white mb-4">
          Download ZeroCoach v1.1 for Mobile.
        </h2>
        <p class="text-slate-300 text-base sm:text-lg leading-relaxed font-light">
          Install the pre-compiled signed release APK on your Android phone, or clone the repository to run on iOS or local emulators.
        </p>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-12">
        <a 
          href="https://github.com/ntsd/zerocoach/releases/latest/download/ZeroCoach-v1.1.0.apk"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 h-12 px-6 rounded-xl text-sm sm:text-base font-bold text-[#080B10] bg-cyan-400 hover:bg-cyan-300 transition-all duration-200 cyan-glow transform hover:-translate-y-0.5"
        >
          <Download class="w-5 h-5 shrink-0" />
          <span>Download Android APK</span>
          <span class="px-2 py-0.5 text-xs font-mono font-bold bg-[#080B10]/20 rounded-md">v1.1 APK</span>
        </a>

        <a 
          href="https://github.com/ntsd/zerocoach/releases"
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 h-12 px-6 rounded-xl text-sm sm:text-base font-semibold text-white bg-white/5 hover:bg-white/10 border border-white/10 hover:border-slate-500 transition-all duration-200"
        >
          <ExternalLink class="w-5 h-5 shrink-0" />
          <span>GitHub Releases</span>
        </a>
      </div>

      <!-- Quick Sideload & OTA Box -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-8 border-t border-white/10">
        <div class="p-4 rounded-2xl bg-slate-950/70 border border-white/5 font-mono text-xs">
          <div class="flex items-center justify-between text-slate-400 mb-2">
            <span class="flex items-center gap-1.5"><Terminal class="w-4 h-4 text-cyan-400" /> Terminal Sideload (ADB)</span>
            <span class="text-cyan-400">Android</span>
          </div>
          <code class="text-cyan-300 block select-all break-all">adb install -r ZeroCoach-v1.1.0.apk</code>
        </div>

        <div class="p-4 rounded-2xl bg-slate-950/70 border border-white/5 font-mono text-xs">
          <div class="flex items-center justify-between text-slate-400 mb-2">
            <span class="flex items-center gap-1.5"><RefreshCw class="w-4 h-4 text-emerald-400" /> Over-The-Air (OTA) Channel</span>
            <span class="text-emerald-400">Instant Hotfix</span>
          </div>
          <div class="text-slate-300">Settings → Check for OTA Updates to receive the latest model prompts and features instantly.</div>
        </div>
      </div>
    </div>
  </div>
</section>
  </div>
</section>
