---
---

<footer class="border-t border-white/5 bg-[#05070A] py-16 relative z-10 text-slate-400 text-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 mb-12">
      <!-- Col 1: Brand & Bio -->
      <div class="md:col-span-2">
        <div class="flex items-center gap-3 mb-4">
          <img src="/logo.svg" alt="ZeroCoach Logo" class="w-8 h-8" />
          <span class="text-xl font-black tracking-wider text-white font-mono">ZEROCOACH</span>
        </div>
        <p class="text-slate-400 text-sm max-w-sm leading-relaxed mb-6 font-light">
          An open-source, privacy-first mobile fitness and AI coaching platform powered by on-device Gemma 2, RepDB kinematics, and Gemini vision. Zero cloud latency and absolute data ownership.
        </p>
        <div class="flex items-center gap-2 text-xs font-mono text-cyan-400">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          <span>Deployed on Render • zerocoach.tech</span>
        </div>
      </div>

      <!-- Col 2: Navigation -->
      <div>
        <h4 class="text-xs font-mono font-bold tracking-wider uppercase text-white mb-4">App Features</h4>
        <ul class="space-y-2.5 text-sm">
          <li><a href="#showcase" class="hover:text-cyan-400 transition-colors">Coach Chat (Gemma 2)</a></li>
          <li><a href="#showcase" class="hover:text-cyan-400 transition-colors">Smart Nutrition & NutriSight</a></li>
          <li><a href="#showcase" class="hover:text-cyan-400 transition-colors">Adaptive Workout (RepDB)</a></li>
          <li><a href="#showcase" class="hover:text-cyan-400 transition-colors">Performance Bio-History</a></li>
          <li><a href="#showcase" class="hover:text-cyan-400 transition-colors">Local Engine & GGUF</a></li>
        </ul>
      </div>

      <!-- Col 3: Resources & Open Source -->
      <div>
        <h4 class="text-xs font-mono font-bold tracking-wider uppercase text-white mb-4">Open Source</h4>
        <ul class="space-y-2.5 text-sm">
          <li>
            <a href="https://github.com/ntsd/zerocoach" target="_blank" rel="noopener noreferrer" class="hover:text-cyan-400 transition-colors flex items-center gap-1.5">
              <span>GitHub Repository</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
            </a>
          </li>
          <li>
            <a href="https://github.com/ntsd/zerocoach/releases" target="_blank" rel="noopener noreferrer" class="hover:text-cyan-400 transition-colors flex items-center gap-1.5">
              <span>Latest Releases</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
            </a>
          </li>
          <li>
            <a href="https://repdb.co" target="_blank" rel="noopener noreferrer" class="hover:text-cyan-400 transition-colors flex items-center gap-1.5">
              <span>RepDB Movement DB</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
            </a>
          </li>
          <li>
            <a href="https://world.openfoodfacts.org/" target="_blank" rel="noopener noreferrer" class="hover:text-cyan-400 transition-colors flex items-center gap-1.5">
              <span>Open Food Facts</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
            </a>
          </li>
          <li>
            <a href="https://github.com/ntsd/zerocoach/blob/main/LICENSE" target="_blank" rel="noopener noreferrer" class="hover:text-cyan-400 transition-colors">
              Apache-2.0 License
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Copyright -->
    <div class="pt-8 border-t border-white/5 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono text-slate-500">
      <div>© 2026 ZeroCoach Authors. Released under Apache-2.0 License.</div>
      <div class="flex items-center gap-4">
        <a href="/privacy" class="hover:text-cyan-400 transition-colors">Privacy Policy</a>
        <span>•</span>
        <span>No Analytics</span>
        <span>•</span>
        <span>No User Tracking</span>
        <span>•</span>
        <span>100% Privacy</span>
      </div>
    </div>
  </div>
</footer>
