---
import { Zap, Dumbbell, ShieldCheck, DollarSign, Play, Download, Sparkles } from 'lucide-astro';
---

<section class="relative pt-8 pb-16 md:pt-14 md:pb-20 overflow-hidden min-h-[calc(100vh-5rem)] flex flex-col justify-center">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
    <!-- Top Pill Badge -->
    <div class="flex justify-center mb-6">
      <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full text-xs font-mono font-semibold bg-gradient-to-r from-cyan-500/10 via-blue-500/10 to-transparent border border-cyan-500/30 text-cyan-300 backdrop-blur-md">
        <span class="flex h-2 w-2 relative">
          <span class="relative inline-flex rounded-full h-2 w-2 bg-cyan-400 shadow-[0_0_8px_#00F0FF]"></span>
        </span>
        <span>100% On-Device AI • Zero Cloud Latency • Absolute Privacy</span>
      </div>
    </div>

    <!-- Main Headline -->
    <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black tracking-tight text-white max-w-5xl mx-auto text-center leading-[1.08] mb-6">
      Athletic Intelligence. <br/>
      <span class="text-gradient-neon">Running Directly On Your Device.</span>
    </h1>

    <!-- Subtitle (16px+ running copy) -->
    <p class="max-w-3xl mx-auto text-center text-base sm:text-lg text-slate-300 leading-relaxed font-light mb-8">
      Zero subscription lock-in. Zero cloud servers. Powered by quantized <span class="text-cyan-300 font-medium">Gemma 2</span> running locally on mobile hardware with <span class="text-cyan-300 font-medium">llama.rn</span>, adaptive <span class="text-white font-medium">RepDB</span> training splits, multimodal food vision, and real-time wearable bio-telemetry.
    </p>

    <!-- CTAs: Balanced Pair with Centered Labels -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 max-w-lg mx-auto mb-12">
      <a 
        href="https://github.com/ntsd/zerocoach/releases/latest/download/ZeroCoach-v1.1.0.apk"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 h-12 px-6 rounded-xl text-sm sm:text-base font-bold text-[#080B10] bg-cyan-400 hover:bg-cyan-300 transition-all duration-200 cyan-glow transform hover:-translate-y-0.5"
      >
        <Download class="w-5 h-5 shrink-0" />
        <span>Download Android APK</span>
        <span class="px-2 py-0.5 text-[10px] font-mono font-bold bg-[#080B10]/20 rounded-md">v1.1</span>
      </a>

      <a 
        href="#demo"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 h-12 px-6 rounded-xl text-sm sm:text-base font-semibold text-white bg-white/5 hover:bg-white/10 border border-white/10 hover:border-slate-500 transition-all duration-200"
      >
        <Play class="w-4 h-4 shrink-0 fill-current text-cyan-400" />
        <span>Watch Pitch Demo</span>
      </a>
    </div>

    <!-- Hero Visual: Product Mockup & Live Telemetry Strip -->
    <div class="max-w-4xl mx-auto mt-2">
      <!-- Live Stats Row with Real Neon Icons (Passing card-visual check) -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4 mb-8">
        <div class="p-4 rounded-2xl glass-panel flex flex-col items-center justify-center text-center">
          <div class="flex items-center gap-2">
            <Zap class="w-4 h-4 text-cyan-400 shrink-0" />
            <div class="text-2xl sm:text-3xl font-black text-white font-mono tracking-tight">0<span class="text-cyan-400">ms</span></div>
          </div>
          <div class="text-xs font-mono uppercase tracking-wider text-slate-400 mt-1">Cloud Latency</div>
        </div>

        <div class="p-4 rounded-2xl glass-panel flex flex-col items-center justify-center text-center">
          <div class="flex items-center gap-2">
            <Dumbbell class="w-4 h-4 text-cyan-400 shrink-0" />
            <div class="text-2xl sm:text-3xl font-black text-white font-mono tracking-tight">643</div>
          </div>
          <div class="text-xs font-mono uppercase tracking-wider text-slate-400 mt-1">RepDB Exercises</div>
        </div>

        <div class="p-4 rounded-2xl glass-panel flex flex-col items-center justify-center text-center">
          <div class="flex items-center gap-2">
            <ShieldCheck class="w-4 h-4 text-cyan-400 shrink-0" />
            <div class="text-2xl sm:text-3xl font-black text-white font-mono tracking-tight">100<span class="text-cyan-400">%</span></div>
          </div>
          <div class="text-xs font-mono uppercase tracking-wider text-slate-400 mt-1">Offline & Private</div>
        </div>

        <div class="p-4 rounded-2xl glass-panel flex flex-col items-center justify-center text-center">
          <div class="flex items-center gap-2">
            <DollarSign class="w-4 h-4 text-cyan-400 shrink-0" />
            <div class="text-2xl sm:text-3xl font-black text-white font-mono tracking-tight">$0</div>
          </div>
          <div class="text-xs font-mono uppercase tracking-wider text-slate-400 mt-1">No Subscriptions</div>
        </div>
      </div>

      <!-- Hero Device Preview Frame -->
      <div class="relative mx-auto max-w-md rounded-[38px] p-2 sm:p-2.5 bg-gradient-to-b from-slate-700 via-slate-900 to-black border border-cyan-500/30 cyan-glow overflow-hidden shadow-2xl">
        <div class="relative rounded-[30px] overflow-hidden bg-[#080B10] aspect-[9/16] max-h-[480px]">
          <img 
            src="/screenshots/coach_chat.png" 
            alt="ZeroCoach Chat Interface on Mobile Device" 
            class="w-full h-full object-cover object-top" 
            loading="eager"
          />
          <!-- Ambient Glass Reflection -->
          <div class="absolute inset-0 bg-gradient-to-tr from-transparent via-white/[0.02] to-white/[0.06] pointer-events-none"></div>
        </div>
      </div>
    </div>
  </div>
</section>
