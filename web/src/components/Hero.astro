---
---

<section class="relative pt-12 pb-16 md:pt-20 md:pb-24 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
    <!-- Top Pill Badge -->
    <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full text-xs font-mono font-semibold bg-gradient-to-r from-cyan-500/10 via-blue-500/10 to-transparent border border-cyan-500/30 text-cyan-300 mb-8 backdrop-blur-md">
      <span class="flex h-2 w-2 relative">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-cyan-400"></span>
      </span>
      <span>100% On-Device AI • Zero Cloud Latency • Absolute Privacy</span>
    </div>

    <!-- Main Headline -->
    <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black tracking-tight text-white max-w-5xl mx-auto leading-[1.1] mb-6">
      Athletic Intelligence. <br/>
      <span class="text-gradient-neon">Running Directly On Your Device.</span>
    </h1>

    <!-- Subtitle -->
    <p class="max-w-3xl mx-auto text-lg sm:text-xl text-slate-300 leading-relaxed font-light mb-10">
      Zero subscription lock-in. Zero cloud servers. Powered by quantized <span class="text-cyan-300 font-medium">Gemma 2</span> running locally on mobile hardware with <span class="text-cyan-300 font-medium">llama.rn</span>, adaptive <span class="text-white font-medium">RepDB</span> training splits, multimodal food vision, and real-time wearable bio-telemetry.
    </p>

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 max-w-xl mx-auto mb-16">
      <a 
        href="https://github.com/ntsd/zerocoach/releases/latest/download/ZeroCoach-v1.1.0.apk"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 rounded-2xl text-base font-bold text-[#080B10] bg-cyan-400 hover:bg-cyan-300 transition-all duration-300 cyan-glow transform hover:-translate-y-0.5"
      >
        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
          <path d="M17.523 15.3414c-.5511 0-.9993-.4486-.9993-1.0001s.4482-.9998.9993-.9998c.5516 0 .9996.4483.9996.9998s-.448 1.0001-.9996 1.0001m-11.046 0c-.5511 0-.9993-.4486-.9993-1.0001s.4482-.9998.9993-.9998c.5516 0 .9996.4483.9996.9998s-.448 1.0001-.9996 1.0001m11.4045-6.02l1.996-3.4566a.4158.4158 0 0 0-.1521-.5676.416.416 0 0 0-.568.1523l-2.0223 3.503C15.5898 8.423 13.849 8.1215 12 8.1215c-1.849 0-3.5898.3015-5.1352.831L4.8425 5.4495a.4162.4162 0 0 0-.568-.1523.4156.4156 0 0 0-.1521.5676l1.996 3.4566C2.688 11.087.348 14.654.024 18.8785h23.952c-.324-4.2245-2.664-7.7915-6.0955-9.5571"/>
        </svg>
        <span>Download APK</span>
        <span class="px-2 py-0.5 text-[10px] font-mono font-bold bg-[#080B10]/20 rounded-md">v1.1</span>
      </a>

      <a 
        href="#demo"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-7 py-4 rounded-2xl text-base font-bold text-cyan-300 bg-cyan-500/10 hover:bg-cyan-500/20 border border-cyan-500/40 hover:border-cyan-400 transition-all duration-300 cyan-glow-subtle"
      >
        <svg class="w-5 h-5 text-cyan-400" fill="currentColor" viewBox="0 0 24 24">
          <path d="M8 5v14l11-7z"/>
        </svg>
        <span>Watch Demo</span>
      </a>

      <a 
        href="https://github.com/ntsd/zerocoach"
        target="_blank"
        rel="noopener noreferrer"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-6 py-4 rounded-2xl text-base font-semibold text-white bg-slate-900/80 hover:bg-slate-800 border border-white/10 hover:border-slate-500 transition-all duration-300"
      >
        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
        </svg>
        <span>GitHub</span>
      </a>
    </div>

    <!-- Live Telemetry / Architecture Stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-4xl mx-auto pt-4 border-t border-white/5">
      <div class="p-4 rounded-2xl glass-panel">
        <div class="text-3xl font-black text-white font-mono tracking-tight">0<span class="text-cyan-400">ms</span></div>
        <div class="text-xs font-mono uppercase tracking-wider text-slate-400 mt-1">Cloud Latency</div>
      </div>
      <div class="p-4 rounded-2xl glass-panel">
        <div class="text-3xl font-black text-white font-mono tracking-tight">643</div>
        <div class="text-xs font-mono uppercase tracking-wider text-slate-400 mt-1">RepDB Exercises</div>
      </div>
      <div class="p-4 rounded-2xl glass-panel">
        <div class="text-3xl font-black text-white font-mono tracking-tight">100<span class="text-cyan-400">%</span></div>
        <div class="text-xs font-mono uppercase tracking-wider text-slate-400 mt-1">Offline & Private</div>
      </div>
      <div class="p-4 rounded-2xl glass-panel">
        <div class="text-3xl font-black text-white font-mono tracking-tight">$0</div>
        <div class="text-xs font-mono uppercase tracking-wider text-slate-400 mt-1">No Subscriptions</div>
      </div>
    </div>
  </div>
</section>
