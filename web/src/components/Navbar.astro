---
---

<header class="sticky top-0 z-50 w-full border-b border-white/5 bg-[#080B10]/80 backdrop-blur-xl transition-all duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    <!-- Brand / Logo -->
    <a href="#" class="flex items-center gap-3 group focus:outline-none focus:ring-2 focus:ring-cyan-400 rounded-lg p-1">
      <div class="relative w-10 h-10 flex items-center justify-center rounded-xl bg-gradient-to-br from-cyan-500/20 via-blue-600/10 to-transparent border border-cyan-500/30 group-hover:border-cyan-400 transition-colors">
        <img src="/logo.svg" alt="ZeroCoach Logo" class="w-7 h-7 transform group-hover:scale-105 transition-transform" />
        <div class="absolute inset-0 rounded-xl bg-cyan-400/20 blur-md opacity-0 group-hover:opacity-100 transition-opacity"></div>
      </div>
      <div class="flex flex-col">
        <div class="flex items-center gap-2">
          <span class="text-xl font-black tracking-wider text-white font-mono">ZEROCOACH</span>
          <span class="px-1.5 py-0.5 text-[10px] font-bold font-mono tracking-wider uppercase bg-cyan-500/15 text-cyan-400 border border-cyan-500/30 rounded">v1.0</span>
        </div>
        <span class="text-[11px] text-slate-400 font-mono tracking-tight hidden sm:inline">100% On-Device AI • Zero Cloud</span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-7 text-sm font-medium text-slate-300">
      <a href="#features" class="hover:text-cyan-400 transition-colors">Features</a>
      <a href="#showcase" class="hover:text-cyan-400 transition-colors">App Showcase</a>
      <a href="#compare" class="hover:text-cyan-400 transition-colors">Privacy Matrix</a>
      <a href="#architecture" class="hover:text-cyan-400 transition-colors">Architecture</a>
      <a href="#models" class="hover:text-cyan-400 transition-colors">AI Models</a>
      <a href="#download" class="hover:text-cyan-400 transition-colors">Download</a>
    </nav>

    <!-- CTAs & GitHub -->
    <div class="flex items-center gap-3">
      <a 
        href="https://github.com/ntsd/zerocoach" 
        target="_blank" 
        rel="noopener noreferrer"
        aria-label="GitHub Repository"
        class="hidden sm:flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-mono font-medium text-slate-300 bg-white/5 border border-white/10 hover:bg-white/10 hover:text-white hover:border-slate-500 transition-all"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
        </svg>
        <span>GitHub</span>
      </a>

      <a 
        href="#download" 
        class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold text-[#080B10] bg-cyan-400 hover:bg-cyan-300 transition-all cyan-glow transform active:scale-95"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
          <path d="M17.523 15.3414c-.5511 0-.9993-.4486-.9993-1.0001s.4482-.9998.9993-.9998c.5516 0 .9996.4483.9996.9998s-.448 1.0001-.9996 1.0001m-11.046 0c-.5511 0-.9993-.4486-.9993-1.0001s.4482-.9998.9993-.9998c.5516 0 .9996.4483.9996.9998s-.448 1.0001-.9996 1.0001m11.4045-6.02l1.996-3.4566a.4158.4158 0 0 0-.1521-.5676.416.416 0 0 0-.568.1523l-2.0223 3.503C15.5898 8.423 13.849 8.1215 12 8.1215c-1.849 0-3.5898.3015-5.1352.831L4.8425 5.4495a.4162.4162 0 0 0-.568-.1523.4156.4156 0 0 0-.1521.5676l1.996 3.4566C2.688 11.087.348 14.654.024 18.8785h23.952c-.324-4.2245-2.664-7.7915-6.0955-9.5571"/>
        </svg>
        <span>Download APK</span>
      </a>
    </div>
  </div>
</header>
