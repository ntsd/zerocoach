---
---

<section id="demo" class="py-20 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-semibold bg-cyan-500/10 text-cyan-400 border border-cyan-500/30 mb-4">
        <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
        <span>HACKTOBERFEST 2026 PITCH DEMO</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-black tracking-tight text-white">
        See ZeroCoach in Action.
      </h2>
      <p class="mt-4 text-base sm:text-lg text-slate-400">
        Watch our 1080p full production walkthrough featuring real on-device Gemma 2 inference, multimodal meal decomposition, and kinetic exercise tracking.
      </p>
    </div>

    <!-- Video Embed Container with Cyber Bezel -->
    <div class="max-w-4xl mx-auto">
      <div class="glass-panel p-2 sm:p-4 rounded-3xl border border-cyan-500/30 cyan-glow relative overflow-hidden">
        <!-- Top bar mockup -->
        <div class="flex items-center justify-between px-3 py-2 border-b border-white/10 mb-3 text-xs font-mono text-slate-400">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-rose-500/80 inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-amber-500/80 inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-emerald-500/80 inline-block"></span>
            <span class="ml-2 text-cyan-300 font-semibold hidden sm:inline">ZEROCOACH_PITCH_DEMO.MP4</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-emerald-400 font-semibold">1080p 60fps</span>
            <a 
              href="https://youtu.be/Ns-7ikl16K0" 
              target="_blank" 
              rel="noopener noreferrer"
              class="text-cyan-400 hover:text-cyan-300 underline font-semibold flex items-center gap-1"
            >
              <span>Watch on YouTube</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
              </svg>
            </a>
          </div>
        </div>

        <!-- 16:9 Responsive Aspect Ratio -->
        <div class="relative w-full aspect-video rounded-2xl overflow-hidden bg-black/90">
          <iframe 
            class="absolute inset-0 w-full h-full border-0"
            src="https://www.youtube-nocookie.com/embed/Ns-7ikl16K0?rel=0" 
            title="ZeroCoach — 100% On-Device AI Athletic Coach Hackathon Pitch Demo" 
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
            allowfullscreen
          ></iframe>
        </div>

        <!-- Timeline Highlights Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-3 lg:grid-cols-5 gap-3 pt-4 text-left">
          <div class="p-3 rounded-xl bg-slate-900/60 border border-white/5 font-mono">
            <div class="text-[10px] text-cyan-400 font-bold uppercase">01 • DISRUPTION</div>
            <div class="text-xs font-semibold text-white mt-1">Zero Subscriptions</div>
            <div class="text-[11px] text-slate-400 mt-0.5">Displaces $100–$200/mo fees with 0-cloud AI.</div>
          </div>
          <div class="p-3 rounded-xl bg-slate-900/60 border border-white/5 font-mono">
            <div class="text-[10px] text-cyan-400 font-bold uppercase">02 • GEMMA 2 AI</div>
            <div class="text-xs font-semibold text-white mt-1">~38 Tok/Sec</div>
            <div class="text-[11px] text-slate-400 mt-0.5">Real-time local GGUF streaming via llama.rn.</div>
          </div>
          <div class="p-3 rounded-xl bg-slate-900/60 border border-white/5 font-mono">
            <div class="text-[10px] text-cyan-400 font-bold uppercase">03 • VISION FOOD</div>
            <div class="text-xs font-semibold text-white mt-1">Plate Decomposition</div>
            <div class="text-[11px] text-slate-400 mt-0.5">Macros + 9 essential micronutrients RDA.</div>
          </div>
          <div class="p-3 rounded-xl bg-slate-900/60 border border-white/5 font-mono">
            <div class="text-[10px] text-cyan-400 font-bold uppercase">04 • WORKOUTS</div>
            <div class="text-xs font-semibold text-white mt-1">Adaptive Splits</div>
            <div class="text-[11px] text-slate-400 mt-0.5">643 RepDB moves with live set tracking.</div>
          </div>
          <div class="p-3 rounded-xl bg-slate-900/60 border border-white/5 font-mono">
            <div class="text-[10px] text-cyan-400 font-bold uppercase">05 • TELEMETRY</div>
            <div class="text-xs font-semibold text-white mt-1">7D Score & Readiness</div>
            <div class="text-[11px] text-slate-400 mt-0.5">Unified composite athletic score.</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
